{
  "name": "reem-sso",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:local": "wrangler d1 execute reem-sso --local --file=schema.sql",
    "db:remote": "wrangler d1 execute reem-sso --remote --file=schema.sql",
    "deploy": "wrangler deploy",
    "test": "wrangler deploy --dry-run --outdir /tmp/ssodist > /dev/null && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "miniflare": "^4.20260730.0",
    "wrangler": "^4.40.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3"
  }
}
