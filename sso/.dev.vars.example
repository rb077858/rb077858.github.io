# Copy to .dev.vars for local development (`npm run dev`).
# DEV=1 shows email links on screen instead of sending them.
DEV=1
ADMIN_EMAILS=you@example.com
# wrangler dev rewrites the host to login.reembir.com, so links in dev need the real local address:
PUBLIC_URL=http://localhost:8787
# Payment page on the same local server, and a fake PayPal (no real charges):
PAY_URL=http://localhost:8787
PAYPAL_MOCK=1
